{
  "expo": {
    "name": "Vigilante",
    "slug": "vigilante",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vigilante",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#050B14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#050B14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eu.hugo.vigilante"
    },
    "android": {
      "package": "eu.hugo.vigilante",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vigilante usa tus fotos para documentar mantenimientos."
        }
      ],
      [
        "expo-notifications",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12c7daba-14c6-4582-b1a2-88ff8d1a2ca7"
      }
    },
    "owner": "hugodzps-team"
  }
}
